# Autonomous Office - Dockerfile for Debian deployment
# Extends the main QLDA image with autonomous capabilities

FROM node:22-alpine

WORKDIR /app

# Install git for auto-commit functionality
RUN apk add --no-cache git

# Copy VAN-PHONG-AI modules
COPY VAN-PHONG-AI/package.json VAN-PHONG-AI/package-lock.json ./VAN-PHONG-AI/
COPY VAN-PHONG-AI/*.js ./VAN-PHONG-AI/
COPY VAN-PHONG-AI/*.sh ./VAN-PHONG-AI/
COPY VAN-PHONG-AI/ai-config.local.json ./VAN-PHONG-AI/ 2>/dev/null || :

# Install autonomous office dependencies
RUN cd VAN-PHONG-AI && npm ci --omit=dev --ignore-scripts

# Create required directories
RUN mkdir -p VAN-PHONG-AI/HO-SO-AI \
             VAN-PHONG-AI/HO-SO-AI/ARCHIVE \
             VAN-PHONG-AI/HO-SO-AI/temp \
             VAN-PHONG-AI/MAU \
             VAN-PHONG-AI/logs \
    && chmod +x VAN-PHONG-AI/*.sh 2>/dev/null || true

# Configure git for auto-commit
RUN git config --global user.name "Autonomous Office AI" && \
    git config --global user.email "ai@autonomous-office.local" && \
    git config --global init.defaultBranch main

# Set permissions
RUN addgroup -S qlda && adduser -S qlda -G qlda && \
    chown -R qlda:qlda /app

USER qlda

# Environment variables
ENV NODE_ENV=production
ENV AUTONOMOUS_OFFICE_ENABLED=true
ENV AI_AUTO_COMMIT=true

# The main server will import and initialize autonomous office
# No separate CMD needed - it runs as part of main server
